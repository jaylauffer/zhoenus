# Visual Studio 2015 user specific files
.vs/
.DS_Store

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico
!Build/Android/res/
!Build/Android/res/drawable/
!Build/Android/res/drawable/icon.png
!Build/Android/res/drawable-ldpi/
!Build/Android/res/drawable-ldpi/icon.png
!Build/Android/res/drawable-mdpi/
!Build/Android/res/drawable-mdpi/icon.png
!Build/Android/res/drawable-hdpi/
!Build/Android/res/drawable-hdpi/icon.png
!Build/Android/res/drawable-xhdpi/
!Build/Android/res/drawable-xhdpi/icon.png
!Build/IOS/Resources/
!Build/IOS/Resources/Graphics/
!Build/IOS/Resources/Graphics/Icon*.png
!Build/IOS/Resources/Graphics/LaunchScreenIOS.png
!Build/Linux/Application.png
!Build/Mac/Application.icns

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*
Plugins/**/Intermediate/*

# Codex temp content for exploration/debugging
Content/__CodexTemp/*

# Local plugin checkout, not part of the public repo
Plugins/VisualStudioTools/

# Cache files for the editor to use
DerivedDataCache/*
